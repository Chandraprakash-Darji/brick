{
  "name": "brick-ts-monorepo",
  "version": "0.1.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/basic"
  ],
  "scripts": {
    "build": "bun run --filter @elregaldo/core build && bun run --filter @elregaldo/cli build",
    "release": "bun scripts/release.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "bench": "bun bench/run-all.ts",
    "bench:smoke": "bun bench/run-all.ts --smoke",
    "bench:micro": "bun bench/micro.ts",
    "bench:http": "bun bench/http.ts",
    "bench:batch": "bun bench/batch.ts",
    "bench:startup": "bun bench/startup.ts",
    "build:compiler": "cargo build --release --manifest-path native/brickc/Cargo.toml",
    "bench:compiled": "bun bench/compiled.ts",
    "bench:fixed-json": "bun bench/fixed-json.ts",
    "bench:native": "bun bench/native.ts",
    "build:native-http": "bun scripts/build-native-http.ts",
    "build:native-bench": "cargo build --release --manifest-path native/brick-http/Cargo.toml",
    "bench:prepared": "bun bench/prepared.ts",
    "bench:postgres": "bun bench/postgres.ts",
    "bench:typecheck": "tsc --noEmit -p bench/tsconfig.json",
    "bench:test": "bun test bench/lab.test.ts",
    "build:native-bridge": "bun scripts/build-native-http.ts --bridge-only"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "elysia": "^1.2.0",
    "typescript": "^5.7.0"
  }
}
