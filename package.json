{
  "name": "brick-ts-monorepo",
  "version": "0.1.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/basic",
    "examples/showcase",
    "examples/extensions"
  ],
  "scripts": {
    "build": "bun run --filter @brickkit/core build && bun run --filter @brickkit/cli build",
    "release": "bun scripts/release.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "bench": "bun bench/run-all.ts",
    "bench:smoke": "bun bench/run-all.ts --smoke",
    "bench:micro": "bun bench/micro.ts",
    "bench:http": "bun bench/http.ts",
    "bench:batch": "bun bench/batch.ts",
    "bench:startup": "bun bench/startup.ts",
    "bench:prepared": "bun bench/prepared.ts",
    "bench:postgres": "bun bench/postgres.ts",
    "bench:typecheck": "tsc --noEmit -p bench/tsconfig.json",
    "bench:test": "bun test bench/lab.test.ts",
    "bench:compiler": "bun bench/compiler.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "elysia": "^1.2.0",
    "typescript": "^5.7.0"
  }
}
