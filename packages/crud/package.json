{
  "name": "@brickkit/crud",
  "version": "0.6.1",
  "description": "Opt-in resource CRUD plugin for Brick",
  "keywords": [
    "typescript",
    "bun",
    "crud",
    "drizzle-orm",
    "postgres",
    "sqlite",
    "rest-api",
    "typebox",
    "backend-framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chandraprakash-Darji/brick.git",
    "directory": "packages/crud"
  },
  "type": "module",
  "license": "MIT",
  "exports": {
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "drizzle-orm": "^0.45.2"
  },
  "peerDependencies": {
    "@brickkit/core": "^0.4.2",
    "effect": "^4"
  },
  "devDependencies": {
    "tsdown": "^0.23.1",
    "typescript": "^5.7.0",
    "@types/bun": "^1.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
