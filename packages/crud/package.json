{
  "name": "@brickkit/crud",
  "version": "0.5.0",
  "description": "Opt-in resource CRUD plugin for Brick",
  "keywords": [
    "typescript",
    "bun",
    "crud",
    "drizzle-orm",
    "postgres",
    "sqlite",
    "rest-api",
    "typebox",
    "backend-framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chandraprakash-Darji/brick.git",
    "directory": "packages/crud"
  },
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "@effect/sql-pg": "4.0.4",
    "@effect/sql-sqlite-bun": "4.0.4"
  },
  "peerDependencies": {
    "@brickkit/core": "^0.5.0",
    "effect": "4.0.4"
  },
  "devDependencies": {
    "tsdown": "^0.23.1",
    "typescript": "^5.7.0",
    "@types/bun": "^1.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
