{
  "name": "@elregaldo/cli",
  "version": "0.1.1",
  "description": "CLI and server engine for Brick-TS",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "brick": "dist/bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brick-org/brick.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@elregaldo/core": "^0.1.0",
    "@sinclair/typebox": "^0.34.0",
    "elysia": "^1.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsdown": "^0.23.0",
    "typescript": "^5.7.0"
  }
}