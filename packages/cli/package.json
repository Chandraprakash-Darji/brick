{
  "name": "@brickkit/cli",
  "version": "0.2.0",
  "description": "CLI and server engine for Brick-TS",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "brick": "dist/bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./compiler": {
      "import": "./dist/compiler.js",
      "types": "./dist/compiler.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chandraprakash-Darji/brick.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@brickkit/core": "^0.2.0",
    "@sinclair/typebox": "^0.34.0",
    "elysia": "^1.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsdown": "^0.23.0",
    "typescript": "^5.7.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0"
  }
}
