{
  "name": "@brickkit/cli",
  "version": "0.8.1",
  "description": "CLI and server engine for Brick-TS",
  "keywords": [
    "typescript",
    "bun",
    "cli",
    "dev-server",
    "elysia",
    "openapi-generator",
    "typed-client",
    "vite-plugin",
    "build-tool",
    "mcp"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "brick": "dist/bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./compiler": {
      "import": "./dist/compiler.js",
      "types": "./dist/compiler.d.ts"
    },
    "./dev-reporter": {
      "import": "./dist/dev-reporter.js",
      "types": "./dist/dev-reporter.d.ts"
    },
    "./vite": {
      "import": "./dist/vite.js",
      "types": "./dist/vite.d.ts"
    },
    "./vite/client": {
      "types": "./vite-client.d.ts"
    },
    "./workflows": {
      "import": "./dist/workflows.js",
      "types": "./dist/workflows.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "dashboard-dist",
    "vite-client.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chandraprakash-Darji/brick.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "bun scripts/build-dashboard.ts && tsdown",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p dashboard/tsconfig.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@brickkit/core": "^0.8.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@sinclair/typebox": "^0.34.52",
    "commander": "^15.0.0",
    "elysia": "2.0.0-beta.29"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@brickkit/workflow-inspector": "workspace:*",
    "@fumadocs/base-ui": "16.17.2",
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@workflow/builders": "5.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.17.2",
    "fumadocs-openapi": "12.5.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.2",
    "geist": "^1.8.1",
    "lucide-react": "^1.56.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.22.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.4",
    "workflow": "5.2.2"
  },
  "peerDependencies": {
    "@mdx-js/mdx": "^3.0.0",
    "fumadocs-core": "^16.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@mdx-js/mdx": {
      "optional": true
    },
    "fumadocs-core": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
