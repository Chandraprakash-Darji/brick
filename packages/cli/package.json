{
  "name": "@brickkit/cli",
  "version": "0.4.2",
  "description": "CLI and server engine for Brick-TS",
  "keywords": [
    "typescript",
    "bun",
    "cli",
    "dev-server",
    "elysia",
    "openapi-generator",
    "typed-client",
    "vite-plugin",
    "build-tool",
    "mcp"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "brick": "dist/bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./compiler": {
      "import": "./dist/compiler.js",
      "types": "./dist/compiler.d.ts"
    },
    "./vite": {
      "import": "./dist/vite.js",
      "types": "./dist/vite.d.ts"
    },
    "./vite/client": {
      "types": "./vite-client.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "vite-client.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chandraprakash-Darji/brick.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@brickkit/core": "^0.4.2",
    "@sinclair/typebox": "^0.34.52",
    "commander": "^15.0.0",
    "elysia": "2.0.0-beta.29"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsdown": "^0.23.1",
    "typescript": "^5.7.0",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
