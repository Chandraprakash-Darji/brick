{
  "name": "@brick/core",
  "version": "0.1.0",
  "description": "Core engine primitives for the Brick-TS framework",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./pg": {
      "import": "./dist/pg.js",
      "types": "./dist/pg.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/brick-org/brick.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "drizzle-orm": "^0.39.0",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsdown": "^0.23.0",
    "typescript": "^5.7.0"
  }
}
