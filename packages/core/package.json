{
  "name": "@brickkit/core",
  "version": "0.5.0",
  "description": "Core engine primitives for the Brick-TS framework",
  "keywords": [
    "typescript",
    "bun",
    "backend-framework",
    "drizzle-orm",
    "typebox",
    "rest-api",
    "openapi",
    "crud",
    "typed-client",
    "mcp"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./pg": {
      "import": "./dist/pg.js",
      "types": "./dist/pg.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chandraprakash-Darji/brick.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.types.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "effect": "4.0.4",
    "postgres": "^3.4.9",
    "@effect/sql-pg": "4.0.4",
    "@effect/sql-sqlite-bun": "4.0.4",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "tsdown": "^0.23.1",
    "typescript": "^5.7.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0"
  }
}
