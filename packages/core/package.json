{
  "name": "@brickkit/core",
  "version": "0.8.1",
  "description": "Core engine primitives for the Brick-TS framework",
  "keywords": [
    "typescript",
    "bun",
    "backend-framework",
    "elysia",
    "drizzle-orm",
    "typebox",
    "rest-api",
    "openapi",
    "crud",
    "typed-client",
    "mcp"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./pg": {
      "import": "./dist/pg.js",
      "types": "./dist/pg.d.ts"
    },
    "./tanstack-query": {
      "import": "./dist/tanstack-query.js",
      "types": "./dist/tanstack-query.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chandraprakash-Darji/brick.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.types.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@sinclair/typebox": "^0.34.52",
    "drizzle-orm": "^0.45.2",
    "elysia": "2.0.0-beta.29",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@tanstack/query-core": "5.104.3",
    "@tanstack/vue-query": "5.104.3",
    "@types/bun": "^1.4.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsdown": "^0.23.1",
    "typescript": "^5.7.0",
    "vue": "^3.5.13"
  },
  "peerDependencies": {
    "@tanstack/query-core": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/query-core": {
      "optional": true
    }
  }
}
