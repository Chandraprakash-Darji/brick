{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.source/**",
    "**/routeTree.gen.ts",
    "**/.output/**",
    "**/.tanstack/**",
    "bench/results/**"
  ]
}
